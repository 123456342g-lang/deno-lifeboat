{
  "name": "deno-lifeboat",
  "version": "0.1.0",
  "description": "Scan a Deno project and migrate it to Node, Bun, or Cloudflare Workers — AST-based, dry-run by default.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deno-lifeboat": "dist/src/cli.js",
    "lifeboat": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p templates/tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lifeboat": "node dist/src/cli.js"
  },
  "keywords": [
    "deno",
    "migration",
    "node",
    "bun",
    "cloudflare-workers",
    "codemod",
    "ts-morph"
  ],
  "dependencies": {
    "diff": "^8.0.2",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "croner": "^10.0.1",
    "typescript": "~5.9.3"
  }
}
